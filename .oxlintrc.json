{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/**"
      ],
      "env": {
        "node": true,
        "browser": false
      }
    }
  ],
  "globals": {
    "__APP_VERSION__": "readonly",
    "__BUILD_AT__": "readonly"
  }
}
