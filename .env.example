# Firebase settings for phone <-> PC sync.
#
# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.
# `.env.local` is gitignored, so your project details stay out of the repo.
#
# Where these come from:
#   Firebase Console -> Project settings (gear icon) -> Your apps -> Web app
#   -> "SDK setup and configuration" -> Config
#
# Leave this file unfilled and the app simply runs without sync. Everything else
# keeps working, and backup/restore still covers you.
#
# These values are NOT secrets. Firebase web config is meant to be public; what
# protects your data is firestore.rules. Deploy those rules before signing in.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# No AI key lives here any more.
#
# There used to be VITE_GEMINI_API_KEY and VITE_GEMINI_MODEL: the AI Coach and
# the food estimator called Gemini straight from the client, billed to prepaid
# credits. Those credits ran out, so both features were rebuilt to cost nothing —
# food estimates are pasted in from whatever free AI chat is on the phone
# (src/utils/foodPaste.js), and the coach became the plain-text export you paste
# into that same chat (src/components/TextExportModal.jsx). Nothing in this app
# calls a paid API. Do not add a key back without deciding who pays for it.

# Where the app checks for a new version (src/utils/updates.js).
#
# MUST be absolute. The APK bundles the whole `dist` folder including its own
# `version.json`, so a relative URL would read the copy baked into the app —
# which always matches the running version, meaning the app would report
# "already up to date" forever no matter how many releases shipped.
#
# Leave unset and it defaults to the project's Firebase Hosting URL. Set it
# only if you host the release manifest somewhere else.
VITE_UPDATE_MANIFEST_URL=
